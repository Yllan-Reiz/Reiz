<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Reiz · Rise to Your Goals</title>
<meta name="description" content="Reiz, l'app qui transforme ton cercle en témoin de tes objectifs. Rise to your goals." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --bg:#0a0a0a;
  --bg2:#101011;
  --bg3:#161617;
  --border:#1e1e1f;
  --border-hi:#333;
  --text:#fafafa;
  --muted:#6e6e72;
  --dim:#2e2e30;
  --radius:24px;
  --display:'Plus Jakarta Sans',system-ui,sans-serif;
  --body:'Inter',system-ui,sans-serif;
}

html{scroll-behavior:smooth}
body{
  background:var(--bg);
  color:var(--text);
  font-family:var(--body);
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}

/* grain */
body::before{
  content:'';
  position:fixed;inset:0;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
  pointer-events:none;z-index:50;opacity:.6;
}

::selection{background:#fff;color:#000}

/* ───────── NAV ───────── */
nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  padding:18px 40px;
  display:flex;align-items:center;justify-content:space-between;
  border-bottom:1px solid transparent;
  transition:border-color .35s,background .35s;
}
nav.scrolled{
  background:rgba(10,10,10,.82);
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
  border-color:var(--border);
}
.nav-logo img{
  height:20px;width:auto;display:block;
}
.nav-cta{
  background:#fff;color:#000;border:none;border-radius:100px;
  padding:10px 22px;font-size:13px;font-weight:700;
  font-family:var(--body);cursor:pointer;text-decoration:none;
  transition:transform .25s cubic-bezier(.34,1.56,.64,1),box-shadow .25s;
}
.nav-cta:hover{transform:scale(1.05);box-shadow:0 0 28px rgba(255,255,255,.22)}

/* ───────── HERO ───────── */
.hero{
  position:relative;
  min-height:100vh;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;
  padding:130px 24px 90px;
  overflow:hidden;
}

/* anneau orbital derrière le logo — discret, fondu sur les bords
   pour ne jamais parasiter le texte */
.hero-ring{
  position:absolute;
  top:42%;left:50%;
  width:min(60vw,500px);height:min(60vw,500px);
  transform:translate(-50%,-50%);
  pointer-events:none;
  opacity:.3;
  -webkit-mask-image:radial-gradient(circle,#000 52%,transparent 80%);
  mask-image:radial-gradient(circle,#000 52%,transparent 80%);
}
.hero-ring svg{width:100%;height:100%;overflow:visible}
.orbit{transform-origin:300px 300px;animation:spin 60s linear infinite}
.orbit.r2{animation-duration:95s;animation-direction:reverse}
@keyframes spin{to{transform:rotate(360deg)}}
.orbit circle.dot{fill:#fff;opacity:.5}
.orbit circle.ring-line{fill:none;stroke:var(--dim);stroke-width:1;opacity:.55}

.hero-eyebrow{
  font-size:11px;font-weight:600;letter-spacing:3.5px;
  color:var(--muted);text-transform:uppercase;
  margin-bottom:24px;position:relative;z-index:2;
  display:inline-flex;align-items:center;gap:10px;
}
.hero-eyebrow::before,.hero-eyebrow::after{
  content:'';width:28px;height:1px;background:var(--dim);
}

.hero-logo{
  margin-bottom:18px;position:relative;z-index:2;
  line-height:0;
}
.hero-logo img{
  width:clamp(260px,46vw,480px);height:auto;display:block;
  filter:drop-shadow(0 0 50px rgba(255,255,255,.12));
}

.hero-tagline{
  font-size:clamp(11px,1.4vw,13px);font-weight:600;letter-spacing:4.5px;
  color:var(--muted);text-transform:uppercase;
  margin-bottom:36px;position:relative;z-index:2;
}

.hero-headline{
  font-family:var(--display);
  font-size:clamp(22px,4vw,32px);
  font-weight:700;line-height:1.35;letter-spacing:-.5px;
  color:rgba(255,255,255,.92);
  max-width:580px;margin-bottom:14px;
  position:relative;z-index:2;
}
.hero-sub{
  font-size:clamp(14px,1.8vw,16px);
  color:var(--muted);line-height:1.6;
  max-width:480px;margin-bottom:40px;
  position:relative;z-index:2;
}

/* form */
.waitlist-form{
  display:flex;gap:10px;width:100%;max-width:440px;
  position:relative;z-index:2;
}
.waitlist-form input{
  flex:1;background:var(--bg2);
  border:1.5px solid var(--border);border-radius:100px;
  padding:15px 22px;color:#fff;font-size:14px;
  font-family:var(--body);outline:none;
  transition:border-color .25s,box-shadow .25s;
}
.waitlist-form input::placeholder{color:var(--dim)}
.waitlist-form input:focus{border-color:#555;box-shadow:0 0 0 4px rgba(255,255,255,.04)}
.waitlist-form button{
  background:#fff;color:#000;border:none;border-radius:100px;
  padding:15px 26px;font-size:14px;font-weight:700;font-family:var(--body);
  cursor:pointer;white-space:nowrap;flex-shrink:0;
  transition:transform .25s cubic-bezier(.34,1.56,.64,1),box-shadow .25s;
}
.waitlist-form button:hover{transform:scale(1.04);box-shadow:0 0 26px rgba(255,255,255,.2)}
.waitlist-form button:active{transform:scale(.97)}

.success-msg{
  display:none;flex-direction:column;align-items:center;gap:8px;
  position:relative;z-index:2;
}
.success-msg .checkmark{font-size:34px}
.success-msg p{font-size:16px;font-weight:700}
.success-msg span{font-size:13px;color:var(--muted)}

.hero-note{
  margin-top:18px;font-size:12px;color:var(--muted);
  position:relative;z-index:2;
}

.scroll-hint{
  position:absolute;bottom:34px;left:50%;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:8px;
  font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:var(--dim);
  z-index:2;
}
.scroll-hint .line{
  width:1px;height:42px;background:var(--dim);overflow:hidden;position:relative;
}
.scroll-hint .line::after{
  content:'';position:absolute;top:-100%;left:0;width:100%;height:100%;
  background:#fff;animation:drop 2.2s cubic-bezier(.65,0,.35,1) infinite;
}
@keyframes drop{to{top:100%}}
/* Sur écran peu haut, le "SCROLL" chevauchait la note du bas : on le masque. */
@media (max-height:860px){ .scroll-hint{display:none} }

/* ───────── FEATURES ───────── */
.features{
  padding:130px 24px;
  max-width:1080px;margin:0 auto;
}
.section-label{
  text-align:center;font-size:11px;font-weight:600;letter-spacing:3.5px;
  color:var(--muted);text-transform:uppercase;margin-bottom:18px;
}
.section-title{
  font-family:var(--display);
  text-align:center;
  font-size:clamp(30px,5.4vw,48px);
  font-weight:800;letter-spacing:-1.8px;line-height:1.12;
  margin-bottom:72px;
}
.section-title span{color:var(--muted)}

.cards{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:16px;
}
.card{
  background:var(--bg2);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:40px 34px;
  transition:border-color .3s,transform .3s,box-shadow .3s;
  will-change:transform,opacity;
}
.card:hover{
  border-color:var(--border-hi);
  transform:translateY(-5px);
  box-shadow:0 18px 50px rgba(0,0,0,.5);
}
.card-num{
  font-family:var(--display);
  font-size:12px;font-weight:700;letter-spacing:2px;
  color:var(--dim);margin-bottom:26px;display:block;
}
.card-icon{
  width:48px;height:48px;margin-bottom:22px;
  display:flex;align-items:center;justify-content:center;
  background:var(--bg3);border:1px solid var(--border);
  border-radius:14px;font-size:22px;
}
.card-title{
  font-family:var(--display);
  font-size:20px;font-weight:800;letter-spacing:-.4px;margin-bottom:12px;
}
.card-body{font-size:14px;color:var(--muted);line-height:1.7}

/* ───────── STORYTELLING (pin + reveal) ───────── */
.story{
  position:relative;
}
.story-inner{
  min-height:100vh;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:0 24px;
  max-width:780px;margin:0 auto;
  text-align:center;
}
.story-line{
  font-family:var(--display);
  font-size:clamp(26px,4.6vw,44px);
  font-weight:800;letter-spacing:-1.4px;line-height:1.25;
  color:#fff;
  opacity:.12;
  margin:14px 0;
  will-change:opacity;
}
.story-line.accent{color:var(--muted)}

/* ───────── LE CERCLE (scroll-linked) ───────── */
.circle-section{position:relative}
.circle-stage{
  min-height:100vh;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  overflow:hidden;
  padding:0 24px;
}
.circle-canvas{
  position:relative;
  width:min(82vw,480px);
  height:min(82vw,480px);
}
.center-you{
  position:absolute;top:50%;left:50%;
  transform:translate(-50%,-50%);
  width:84px;height:84px;border-radius:50%;
  background:#fff;color:#000;
  display:flex;align-items:center;justify-content:center;
  font-family:var(--display);font-weight:800;font-size:15px;letter-spacing:1px;
  box-shadow:0 0 60px rgba(255,255,255,.18);
  z-index:3;
}
.witness{
  position:absolute;top:50%;left:50%;
  width:46px;height:46px;border-radius:50%;
  background:var(--bg3);
  border:1.5px solid var(--dim);
  display:flex;align-items:center;justify-content:center;
  font-size:18px;
  will-change:transform,opacity;
  z-index:2;
}
.circle-trace{
  position:absolute;inset:0;
  border:1px dashed var(--dim);
  border-radius:50%;
  opacity:0;
  transform:scale(.9);
  will-change:transform,opacity;
}
.circle-captions{
  position:relative;
  height:64px;margin-top:46px;
  width:100%;max-width:520px;
  text-align:center;
}
.circle-caption{
  position:absolute;inset:0;
  font-family:var(--display);
  font-size:clamp(19px,3.2vw,26px);
  font-weight:800;letter-spacing:-.6px;line-height:1.3;
  will-change:opacity,transform;
}
.circle-caption small{
  display:block;margin-top:8px;
  font-family:var(--body);
  font-size:13px;font-weight:500;letter-spacing:0;
  color:var(--muted);
}
.circle-caption.c2{opacity:0}

/* ───────── CHIFFRES ───────── */
.stats{
  padding:130px 24px;
  max-width:1080px;margin:0 auto;
}
.stats-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
  gap:16px;
}
.stat{
  background:var(--bg2);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:46px 34px;
  text-align:center;
  transition:border-color .3s;
}
.stat:hover{border-color:var(--border-hi)}
.stat-value{
  font-family:var(--display);
  font-size:clamp(52px,8vw,76px);
  font-weight:800;letter-spacing:-3px;line-height:1;
  margin-bottom:14px;
  font-variant-numeric:tabular-nums;
}
.stat-value sup{font-size:.45em;letter-spacing:0;color:var(--muted);font-weight:700}
.stat-label{font-size:13px;color:var(--muted);line-height:1.55}
.stat-source{display:block;margin-top:8px;font-size:10px;color:var(--dim);letter-spacing:.5px}

/* ───────── CTA FINAL ───────── */
.cta-section{
  padding:70px 24px 150px;
  text-align:center;
  max-width:620px;margin:0 auto;
}
.cta-section h2{
  font-family:var(--display);
  font-size:clamp(30px,5.4vw,48px);
  font-weight:800;letter-spacing:-1.8px;line-height:1.12;
  margin-bottom:18px;
}
.cta-section p{
  font-size:15px;color:var(--muted);margin-bottom:44px;line-height:1.65;
}
.cta-section .waitlist-form{margin:0 auto;justify-content:center}

/* ───────── FOOTER ───────── */
footer{
  border-top:1px solid var(--border);
  padding:34px 40px;
  display:flex;align-items:center;justify-content:space-between;
  flex-wrap:wrap;gap:16px;
}
footer .logo img{height:16px;width:auto;display:block;opacity:.9}
footer p{font-size:12px;color:var(--muted)}
footer a{
  color:var(--muted);text-decoration:none;font-size:12px;
  position:relative;transition:color .25s;
}
footer a::after{
  content:'';position:absolute;left:0;bottom:-3px;
  width:100%;height:1px;background:#fff;
  transform:scaleX(0);transform-origin:right;
  transition:transform .3s cubic-bezier(.65,0,.35,1);
}
footer a:hover{color:#fff}
footer a:hover::after{transform:scaleX(1);transform-origin:left}

/* ───────── ANIM INIT STATES (JS only) ───────── */
.js .hero-eyebrow,.js .hero-logo,.js .hero-tagline,
.js .hero-headline,.js .hero-sub,
.js .hero .waitlist-form,.js .hero-note,.js .scroll-hint{opacity:0}
.js .card{opacity:0;transform:translateY(40px)}
.js .section-label,.js .section-title{opacity:0;transform:translateY(24px)}
.js .stat{opacity:0;transform:translateY(40px)}
.js .cta-section h2,.js .cta-section p,.js .cta-section .waitlist-form{opacity:0;transform:translateY(24px)}

/* reduced motion : tout visible, rien ne bouge */
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
  html{scroll-behavior:auto}
  .js .hero-eyebrow,.js .hero-logo,.js .hero-tagline,.js .hero-headline,.js .hero-sub,
  .js .hero .waitlist-form,.js .hero-note,.js .scroll-hint,
  .js .card,.js .section-label,.js .section-title,.js .stat,
  .js .cta-section h2,.js .cta-section p,.js .cta-section .waitlist-form{
    opacity:1!important;transform:none!important;
  }
  .story-line{opacity:1!important}
  .circle-caption.c1{opacity:0!important}
  .circle-caption.c2{opacity:1!important}
}

@media (max-width:600px){
  nav{padding:14px 20px}
  .waitlist-form{flex-direction:column}
  .waitlist-form input,.waitlist-form button{width:100%;border-radius:16px}
  footer{flex-direction:column;align-items:flex-start}
  .center-you{width:68px;height:68px;font-size:13px}
  .witness{width:38px;height:38px;font-size:15px}
}
</style>
</head>
<body>

<!-- NAV -->
<nav id="nav">
  <div class="nav-logo"><img src="data:image/png;base64," alt="Reiz" /></div>
  <a class="nav-cta" href="#cta">Rejoindre la liste →</a>
</nav>

<!-- ═══════ 1 · HERO ═══════ -->
<section class="hero">
  <div class="hero-ring" aria-hidden="true">
    <svg viewBox="0 0 600 600">
      <g class="orbit">
        <circle class="ring-line" cx="300" cy="300" r="250"/>
        <circle class="dot" cx="300" cy="50" r="4"/>
        <circle class="dot" cx="512" cy="175" r="3"/>
        <circle class="dot" cx="512" cy="425" r="4"/>
        <circle class="dot" cx="300" cy="550" r="3"/>
        <circle class="dot" cx="88"  cy="425" r="4"/>
        <circle class="dot" cx="88"  cy="175" r="3"/>
      </g>
      <g class="orbit r2">
        <circle class="ring-line" cx="300" cy="300" r="180"/>
        <circle class="dot" cx="300" cy="120" r="3"/>
        <circle class="dot" cx="455" cy="390" r="3"/>
        <circle class="dot" cx="145" cy="390" r="3"/>
      </g>
    </svg>
  </div>

  <p class="hero-eyebrow">Bientôt disponible</p>
  <h1 class="hero-logo"><img src="data:image/png;base64," alt="Reiz" /></h1>
  <p class="hero-tagline">Rise to Your Goals</p>

  <p class="hero-headline">T'as des objectifs.<br>Il te manque le cercle.</p>
  <p class="hero-sub">Partage ta progression chaque jour avec les gens qui comptent. Quand ton cercle regarde, tu ne lâches plus.</p>

  <form class="waitlist-form" id="hero-form">
    <input type="email" placeholder="ton@email.com" required aria-label="Ton adresse email" />
    <button type="submit">Rejoindre →</button>
  </form>

  <div class="success-msg" id="hero-success">
    <span class="checkmark">🔥</span>
    <p>Tu es sur la liste !</p>
    <span>On te prévient dès que Reiz est disponible.</span>
  </div>

  <p class="hero-note">Gratuit · Pas de spam · Prévenu en premier</p>

  <div class="scroll-hint" aria-hidden="true">
    <span>Scroll</span>
    <div class="line"></div>
  </div>
</section>

<!-- ═══════ 2 · FEATURES ═══════ -->
<section class="features">
  <p class="section-label">Pourquoi Reiz</p>
  <h2 class="section-title">La discipline seul,<br><span>ça ne tient pas.</span></h2>

  <div class="cards">
    <div class="card">
      <span class="card-num">01</span>
      <div class="card-icon">👥</div>
      <h3 class="card-title">Ton cercle, tes règles</h3>
      <p class="card-body">Tu choisis qui voit ta progression. Pas des inconnus : les gens qui comptent vraiment pour toi. Amis, famille, entraîneur.</p>
    </div>
    <div class="card">
      <span class="card-num">02</span>
      <div class="card-icon">🔥</div>
      <h3 class="card-title">Le streak qui brûle</h3>
      <p class="card-body">Chaque jour posté allume ta flamme. Plus tu es régulier, plus elle s'enflamme. Ton cercle la voit grandir, ou s'éteindre.</p>
    </div>
    <div class="card">
      <span class="card-num">03</span>
      <div class="card-icon">💪</div>
      <h3 class="card-title">La progression en vrai</h3>
      <p class="card-body">Photos, chiffres, objectifs. Ton cercle réagit, commente, te pousse. Pas des likes vides, de la vraie accountability.</p>
    </div>
  </div>
</section>

<!-- ═══════ 3 · STORYTELLING ═══════ -->
<section class="story" id="story">
  <div class="story-inner">
    <p class="story-line">Tu ne manques pas de motivation.</p>
    <p class="story-line">Personne ne regarde tes efforts,<br>c'est tout.</p>
    <p class="story-line accent">Et quand personne ne regarde,<br>sauter une séance, c'est gratuit.</p>
    <p class="story-line">Reiz change la règle :<br>ton cercle te regarde.</p>
  </div>
</section>

<!-- ═══════ 4 · LE CERCLE (scroll-linked) ═══════ -->
<section class="circle-section" id="cercle">
  <div class="circle-stage">
    <div class="circle-canvas" id="circle-canvas">
      <div class="circle-trace" id="circle-trace"></div>
      <div class="center-you">TOI</div>
      <!-- witnesses injectés en JS -->
    </div>
    <div class="circle-captions">
      <p class="circle-caption c1">Seul face à tes objectifs.<small>C'est là que 9 personnes sur 10 abandonnent.</small></p>
      <p class="circle-caption c2">Entouré. Observé. Tenu.<small>Ton cercle devient ton moteur.</small></p>
    </div>
  </div>
</section>

<!-- ═══════ 5 · CHIFFRES ═══════ -->
<section class="stats">
  <p class="section-label">Les faits</p>
  <h2 class="section-title">Pourquoi ça marche.</h2>

  <div class="stats-grid">
    <div class="stat">
      <div class="stat-value"><span data-count="92">0</span><sup>%</sup></div>
      <p class="stat-label">des résolutions abandonnées quand on est seul</p>
      <span class="stat-source">Université de Scranton</span>
    </div>
    <div class="stat">
      <div class="stat-value"><span data-count="1">0</span></div>
      <p class="stat-label">photo par jour. C'est tout ce que ça demande.</p>
    </div>
    <div class="stat">
      <div class="stat-value"><span data-count="10">0</span><sup>s</sup></div>
      <p class="stat-label">pour poster ta preuve du jour et nourrir ton streak</p>
    </div>
  </div>
</section>

<!-- ═══════ 6 · CTA FINAL + FOOTER ═══════ -->
<section class="cta-section" id="cta">
  <h2>Rejoins les premiers.</h2>
  <p>Reiz se lance d'abord avec un petit groupe d'athlètes et de personnes qui ont de vrais objectifs. Inscris-toi pour en faire partie.</p>

  <form class="waitlist-form" id="cta-form">
    <input type="email" placeholder="ton@email.com" required aria-label="Ton adresse email" />
    <button type="submit">Rejoindre la liste</button>
  </form>

  <div class="success-msg" id="cta-success">
    <span class="checkmark">🔥</span>
    <p>Tu es sur la liste !</p>
    <span>On te prévient dès que Reiz est disponible.</span>
  </div>
</section>

<footer>
  <div class="logo"><img src="data:image/png;base64," alt="Reiz" /></div>
  <p>© 2026 Reiz · Rise to Your Goals</p>
  <p><a href="cgu.html">CGU</a> · <a href="confidentialite.html">Confidentialité</a> · <a href="mailto:reizapp.contact@gmail.com">Contact</a></p>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script>
const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ── NAV scroll ── */
const nav = document.getElementById('nav');
window.addEventListener('scroll', () => {
  nav.classList.toggle('scrolled', window.scrollY > 40);
}, { passive: true });

/* ── Witnesses : générés dans tous les cas ── */
const canvas = document.getElementById('circle-canvas');
const EMOJIS = ['🏋️','🏃','🧗','🚴','🥊','🏊','⛹️','🤸'];
const N = 8;
const witnesses = [];

for (let i = 0; i < N; i++) {
  const el = document.createElement('div');
  el.className = 'witness';
  el.textContent = EMOJIS[i % EMOJIS.length];
  canvas.appendChild(el);
  witnesses.push(el);
}

function layoutWitnesses(progress) {
  // progress 0 → dispersés, lointains, à peine visibles
  // progress 1 → cercle parfait autour de TOI
  const rect = canvas.getBoundingClientRect();
  const R = rect.width / 2 - 26; // rayon final
  witnesses.forEach((el, i) => {
    const angle = (i / N) * Math.PI * 2 - Math.PI / 2;
    // position finale (cercle)
    const fx = Math.cos(angle) * R;
    const fy = Math.sin(angle) * R;
    // position initiale (dispersée, hors champ, pseudo-aléatoire stable)
    const seed = Math.sin(i * 127.1) * 43758.5453;
    const rnd = seed - Math.floor(seed);
    const scatterAngle = angle + (rnd - .5) * 2.4;
    const scatterDist = R * (2.1 + rnd * 1.4);
    const sx = Math.cos(scatterAngle) * scatterDist;
    const sy = Math.sin(scatterAngle) * scatterDist;
    // easing par élément (léger décalage pour un effet organique)
    const offset = (i / N) * .25;
    const p = Math.min(1, Math.max(0, (progress - offset) / (1 - offset || 1)));
    const e = 1 - Math.pow(1 - p, 3); // easeOutCubic
    const x = sx + (fx - sx) * e;
    const y = sy + (fy - sy) * e;
    el.style.transform = `translate(calc(-50% + ${x}px), calc(-50% + ${y}px)) scale(${.6 + .4 * e})`;
    el.style.opacity = .15 + .85 * e;
    el.style.borderColor = e > .85 ? '#555' : '';
  });
}

/* ════════ MODE ANIMÉ (GSAP) ════════ */
if (!reducedMotion && window.gsap) {
  document.documentElement.classList.add('js');
  gsap.registerPlugin(ScrollTrigger);

  /* 1 · HERO : timeline d'entrée */
  gsap.timeline({ defaults: { ease: 'power3.out', duration: .9 } })
    .to('.hero-eyebrow', { opacity: 1, y: 0, startAt: { y: 20 } }, .15)
    .to('.hero-logo',    { opacity: 1, y: 0, startAt: { y: 36 }, duration: 1.1 }, .3)
    .to('.hero-tagline', { opacity: 1, y: 0, startAt: { y: 16 } }, .55)
    .to('.hero-headline',{ opacity: 1, y: 0, startAt: { y: 24 } }, .7)
    .to('.hero-sub',     { opacity: 1, y: 0, startAt: { y: 18 } }, .82)
    .to('.hero .waitlist-form', { opacity: 1, y: 0, startAt: { y: 18 } }, .95)
    .to('.hero-note',    { opacity: 1 }, 1.1)
    .to('.scroll-hint',  { opacity: 1 }, 1.3);

  /* parallax léger de l'anneau du hero */
  gsap.to('.hero-ring', {
    yPercent: 18, opacity: .25, ease: 'none',
    scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true }
  });

  /* 2 · FEATURES : labels + cartes en stagger */
  document.querySelectorAll('.features, .stats').forEach(section => {
    gsap.to(section.querySelectorAll('.section-label, .section-title'), {
      opacity: 1, y: 0, duration: .8, ease: 'power3.out', stagger: .12,
      scrollTrigger: { trigger: section, start: 'top 72%' }
    });
  });

  gsap.to('.card', {
    opacity: 1, y: 0, duration: .85, ease: 'power3.out', stagger: .14,
    scrollTrigger: { trigger: '.cards', start: 'top 78%' }
  });

  /* Cartes de la section stats ("Pourquoi ça marche") — même entrée que les .card.
     Sans ce tween, elles restaient à opacity:0 (règle CSS .js .stat) pour toujours. */
  gsap.to('.stat', {
    opacity: 1, y: 0, duration: .85, ease: 'power3.out', stagger: .14,
    scrollTrigger: { trigger: '.stats-grid', start: 'top 78%' }
  });

  /* 3 · STORYTELLING : pin + lignes qui s'allument (scrub) */
  const lines = gsap.utils.toArray('.story-line');
  const storyTl = gsap.timeline({
    scrollTrigger: {
      trigger: '.story',
      start: 'top top',
      end: '+=' + (lines.length * 60) + '%',
      pin: true,
      scrub: .6
    }
  });
  lines.forEach((line) => {
    storyTl.to(line, { opacity: 1, duration: 1, ease: 'none' })
           .to(line, { opacity: .35, duration: .6, ease: 'none' }, '+=.3');
  });
  // la dernière ligne reste allumée
  storyTl.to(lines[lines.length - 1], { opacity: 1, duration: .4 });

  /* 4 · LE CERCLE : scroll-linked continu */
  const progressProxy = { p: 0 };
  layoutWitnesses(0);

  gsap.timeline({
    scrollTrigger: {
      trigger: '.circle-section',
      start: 'top top',
      end: '+=160%',
      pin: true,
      scrub: .5
    }
  })
  .to(progressProxy, {
    p: 1, ease: 'none', duration: 1,
    onUpdate: () => layoutWitnesses(progressProxy.p)
  }, 0)
  .to('#circle-trace', { opacity: .6, scale: 1, ease: 'none', duration: .5 }, .45)
  .to('.circle-caption.c1', { opacity: 0, y: -10, duration: .25 }, .4)
  .to('.circle-caption.c2', { opacity: 1, y: 0, startAt: { y: 12 }, duration: .3 }, .55);

  window.addEventListener('resize', () => layoutWitnesses(progressProxy.p), { passive: true });

  /* 5 · COMPTEURS */
  document.querySelectorAll('[data-count]').forEach(el => {
    const target = +el.dataset.count;
    gsap.to(el, {
      scrollTrigger: { trigger: el, start: 'top 85%' },
      innerText: target,
      duration: 1.6,
      ease: 'power2.out',
      snap: { innerText: 1 }
    });
  });

  /* 6 · CTA FINAL */
  gsap.to('.cta-section h2, .cta-section p, .cta-section .waitlist-form', {
    opacity: 1, y: 0, duration: .8, ease: 'power3.out', stagger: .12,
    scrollTrigger: { trigger: '.cta-section', start: 'top 75%' }
  });

} else {
  /* ════════ MODE SANS ANIMATION ════════ */
  layoutWitnesses(1); // cercle directement formé
  document.querySelectorAll('[data-count]').forEach(el => {
    el.textContent = el.dataset.count;
  });
}

/* ── Formulaires ── */
// Clé publique Supabase (anon) — conçue pour être exposée côté client.
const SUPABASE_URL = 'https://vpaizbtetwsnvbpmeuab.supabase.co';
const SUPABASE_ANON_KEY = 'sb_publishable_dAHRrHfSQvNwm1LEpNw5Ww_EOTyejXT';

function bindForm(id) {
  const form = document.getElementById(`${id}-form`);
  const success = document.getElementById(`${id}-success`);
  let errEl = null;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = form.querySelector('input').value.trim().toLowerCase();
    if (!email) return;
    const btn = form.querySelector('button');
    if (btn) btn.disabled = true;
    if (errEl) { errEl.remove(); errEl = null; }

    let ok = false;
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/waitlist`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          apikey: SUPABASE_ANON_KEY,
          Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
        },
        body: JSON.stringify({ email }),
      });
      // 409 = email déjà inscrit : on le traite comme un succès
      ok = res.ok || res.status === 409;
    } catch (_) { ok = false; }

    if (btn) btn.disabled = false;
    if (!ok) {
      errEl = document.createElement('p');
      errEl.textContent = "Oups, ça n'a pas marché. Réessaie dans un instant.";
      errEl.style.cssText = 'color:#ff6b61;font-size:13px;margin-top:10px';
      form.after(errEl);
      return;
    }

    form.style.display = 'none';
    success.style.display = 'flex';
    if (!reducedMotion && window.gsap) {
      gsap.from(success, { opacity: 0, y: 12, duration: .5, ease: 'power3.out' });
      gsap.from(success.querySelector('.checkmark'), {
        scale: 0, duration: .5, ease: 'back.out(2.2)', delay: .1
      });
    }
  });
}
bindForm('hero');
bindForm('cta');
</script>
</body>
</html>
