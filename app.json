{
  "expo": {
    "name": "Reiz",
    "slug": "reiz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yllan.reiz",
      "infoPlist": {
        "NSCameraUsageDescription": "Reiz utilise l'appareil photo pour publier ta progression et ta photo de profil.",
        "NSPhotoLibraryUsageDescription": "Reiz accède à ta galerie pour publier ta progression et ta photo de profil."
      }
    },
    "android": {
      "package": "com.yllan.reiz",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1a1a1a",
          "sounds": []
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "69071c24-329f-4426-b10b-8b5fbe280564"
      }
    },
    "owner": "yllan"
  }
}
